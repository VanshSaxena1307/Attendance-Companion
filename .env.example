# Optional local overrides. The application runs with the defaults below.
PORT=5000
VITE_API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Authentication timing can be tuned by deployment configuration. Development
# OTPs are logged by the mock provider only when NODE_ENV is not production.
AUTH_SESSION_TTL_MS=28800000
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=30000
# DATABASE_URL=postgresql://username:password@localhost:5432/attendance_companion
